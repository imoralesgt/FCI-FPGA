# Vitis HLS / Vivado generated project artifacts
*_prj/
vivado*.jou
vivado*.log
vivado*.str
vitis_hls.log
.Xil/
*.Xil/
webtalk*.jou
webtalk*.log
fsm_encoding.os

# Exported/generated IP and bitstreams (regenerate via scripts/run_hls.tcl etc.)
!fpga/ip/*
!fpga/ip/.gitkeep
fpga/bitstream/*
!fpga/bitstream/.gitkeep

# Convention: any project_* dir under fpga/ (e.g. fpga/projects/project_fci) is a local Vivado
# project, not checked in -- fpga/bd/ holds the exported block-design tcl instead, which IS
# checked in (do not ignore that).
fpga/**/project_*/

# Generated by scripts/run_hls.tcl, machine-specific absolute path
fpga/hls/fci_core/tb/data_csv_path.hpp

# xvhdl/xelab/xsim simulation build output and logs (regenerate via scripts/run_sim.sh)
xsim_work/
*.wdb
*.pb
xsim.dir/
xelab.log
xsim.log
xvhdl.log
xvhdl.pb
webtalk*.tcl
