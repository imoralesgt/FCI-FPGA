# Vitis HLS / Vivado generated project artifacts
*_prj/
vivado*.jou
vivado*.log
vivado*.str
vitis_hls.log
.Xil/
*.Xil/
webtalk*.jou
webtalk*.log
fsm_encoding.os


# Convention: any project_* dir under fpga/ (e.g. fpga/projects/project_fci) is a local Vivado
# project, not checked in -- fpga/bd/ holds the exported block-design tcl instead, which IS
# checked in (do not ignore that).
fpga/**/project_*/

# Generated by scripts/run_hls.tcl, machine-specific absolute path
fpga/hls/fci_core/tb/data_csv_path.hpp

# Scratch Vivado projects created by the hand-written cores' own scripts (package_ip.tcl,
# generate_ip.tcl, run_sim_top.tcl). Same reasoning as the project_* rule above: the script is
# what's checked in, not its output.
fpga/rtl/**/scripts/*_proj/

# Xilinx IP generated by fpga/rtl/fci_core_rtl/scripts/generate_ip.tcl -- ~15 MB of synthesis and
# simulation models fully determined by that script's CONFIG.* settings, so the script is the
# source of truth and this is regenerable output. (The PACKAGED core under fpga/ip/ is different
# and IS checked in, same as trigger_core's.)
fpga/rtl/fci_core_rtl/ip/

# xvhdl/xelab/xsim simulation build output and logs (regenerate via scripts/run_sim.sh)
xsim_work/
*.wdb
*.pb
xsim.dir/
*.log
xvhdl.log
xvhdl.pb
webtalk*.tcl

# Leftovers of Python runs in the data analysis folder
*.pyc